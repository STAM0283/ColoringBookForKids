# Copier ce fichier vers /var/www/app/site/shared/.env.production sur OVH.
# Ne jamais enregistrer le fichier réel dans Git.
APP_ENV="production"
AUTH_SECRET="replace-with-a-random-production-secret"
AUTH_TRUST_HOST="true"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/lena.stam.coloringbook"
GOOGLE_SITE_VERIFICATION=""
DATABASE_PATH="/var/www/data/database/site.db"
MEDIA_ROOT="/var/www/data/media"
BACKUP_ROOT="/var/www/data/backups"
STORAGE_CAPACITY_BYTES="42949672960"
HOSTING_PROVIDER="OVH"
