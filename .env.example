# Application
APP_ENV=development
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/lena.stam.coloringbook
GOOGLE_SITE_VERIFICATION=

# PostgreSQL installé localement ou sur le VPS.
# Format : postgresql://utilisateur:mot_de_passe@hote:port/base
DATABASE_URL=postgresql://coloringbook:replace-with-a-long-random-database-password@localhost:5432/coloringbook
# Nombre maximal de connexions ouvertes par l'application.
DATABASE_POOL_SIZE=10

# Authentification
AUTH_SECRET=replace-with-openssl-rand-base64-48
AUTH_TRUST_HOST=true
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=ChangeMe-Only-For-Local-Dev!

# Fichiers persistants (utiliser des chemins absolus sur le VPS)
MEDIA_ROOT=./data/uploads
BACKUP_ROOT=./backups
STORAGE_CAPACITY_BYTES=42949672960
HOSTING_PROVIDER="OVH VPS"

# Rétention des sauvegardes créées par scripts/backup-*.sh
DAILY_RETENTION_DAYS=7
WEEKLY_RETENTION_DAYS=28
MONTHLY_RETENTION_DAYS=93
UPLOADS_RETENTION_DAYS=7
